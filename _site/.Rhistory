# =============================================================================
# Transfer Fee / Age Band Claim Test
# Version 2.0
# =============================================================================
# Purpose:
#   Test the claim: "Only 4 28-30 year olds have been sold for more than
#   GBP 55m", scoped to transfers INTO Premier League clubs.
#
# Changes in v2.0:
#   - CHANGED: transfer event is now the INCOMING move (join_date + fee_in),
#     replacing the outgoing framing (leave_date + fee_out) used in v1.0
#   - CHANGED: age measured at join_date (date of transfer in)
#   - REMOVED: leave_date requirement, so current squad members are included
#   - UPDATED: cross-check now compares fee_in against the preceding fee_out
#   - ADDED: duplicate join detection
#   - ADDED: base rate context by age band
#
# Changes in v1.0:
#   - Initial version
#
# SCOPE:
#   player_club.csv records spells at Premier League clubs only. This tests
#   transfers INTO PL clubs, 1992/93 onwards. Moves between two non-English
#   clubs are invisible here, so counts are a floor, not a ceiling.
#
# Conventions applied:
#   - Fees denominated in GBP thousands (55000 = GBP 55m)
#   - Sentinel value 99 = unknown / undisclosed -> treated as NA
#   - Age = completed years at join_date
#   - Read-only: writes only to output/transfer_fee_age_check/
# =============================================================================
library(data.table)
# ---- CONFIG -----------------------------------------------------------------
DATA_DIR   <- "data"
OUTPUT_DIR <- file.path("output", "transfer_fee_age_check")
FEE_THRESHOLD_K <- 55000     # GBP 55m expressed in thousands
AGE_MIN         <- 28
AGE_MAX         <- 30
SENTINEL_FEE    <- 99        # unknown / undisclosed
PERMANENT_ONLY  <- TRUE      # exclude loan arrivals
dir.create(OUTPUT_DIR, recursive = TRUE, showWarnings = FALSE)
# ---- HELPERS ----------------------------------------------------------------
completed_years <- function(birth, ref) {
by <- as.integer(format(birth, "%Y"))
bm <- as.integer(format(birth, "%m"))
bd <- as.integer(format(birth, "%d"))
ry <- as.integer(format(ref,   "%Y"))
rm <- as.integer(format(ref,   "%m"))
rd <- as.integer(format(ref,   "%d"))
a <- ry - by
a - as.integer((rm < bm) | (rm == bm & rd < bd))
}
fmt_m <- function(k) sprintf("%.1fm", k / 1000)
stop_if <- function(cond, msg) if (isTRUE(cond)) stop(msg, call. = FALSE)
banner <- function(txt) {
cat("\n", strrep("=", 78), "\n", txt, "\n", strrep("=", 78), "\n", sep = "")
}
# ---- LOAD -------------------------------------------------------------------
banner("LOADING DATA")
pc_path <- file.path(DATA_DIR, "player_club.csv")
pl_path <- file.path(DATA_DIR, "players.csv")
tm_path <- file.path(DATA_DIR, "teams.csv")
for (p in c(pc_path, pl_path, tm_path)) {
stop_if(!file.exists(p), paste0("FATAL: file not found -> ", p))
}
# =============================================================================
# Transfer Fee / Age Band Claim Test
# Version 2.1
# =============================================================================
# Purpose:
#   Test the claim: "Only 4 28-30 year olds have been sold for more than
#   GBP 55m", scoped to transfers INTO Premier League clubs.
#
# Changes in v2.1:
#   - FIXED: CSV location is now auto-detected. Previously hardcoded to
#     "data/", which failed when the CSVs sit in the project root.
#     Searches: repo root, then data/, then data-archive/. Override with
#     DATA_DIR if the files live elsewhere.
#   - ADDED: reports which directory was used, so the source is never
#     ambiguous when reading the output
#
# Changes in v2.0:
#   - CHANGED: transfer event is now the INCOMING move (join_date + fee_in),
#     replacing the outgoing framing (leave_date + fee_out) used in v1.0
#   - CHANGED: age measured at join_date (date of transfer in)
#   - REMOVED: leave_date requirement, so current squad members are included
#   - UPDATED: cross-check now compares fee_in against the preceding fee_out
#   - ADDED: duplicate join detection
#   - ADDED: base rate context by age band
#
# Changes in v1.0:
#   - Initial version
#
# SCOPE:
#   player_club.csv records spells at Premier League clubs only. This tests
#   transfers INTO PL clubs, 1992/93 onwards. Moves between two non-English
#   clubs are invisible here, so counts are a floor, not a ceiling.
#
# Conventions applied:
#   - Fees denominated in GBP thousands (55000 = GBP 55m)
#   - Sentinel value 99 = unknown / undisclosed -> treated as NA
#   - Age = completed years at join_date
#   - Read-only: writes only to output/transfer_fee_age_check/
# =============================================================================
library(data.table)
# ---- CONFIG -----------------------------------------------------------------
# Set DATA_DIR to a specific path to override auto-detection.
# Leave as NULL to search the candidate directories below.
DATA_DIR       <- NULL
DATA_DIR_TRY   <- c(".", "data", "data-archive")
OUTPUT_DIR <- file.path("output", "transfer_fee_age_check")
FEE_THRESHOLD_K <- 55000     # GBP 55m expressed in thousands
AGE_MIN         <- 28
AGE_MAX         <- 30
SENTINEL_FEE    <- 99        # unknown / undisclosed
PERMANENT_ONLY  <- TRUE      # exclude loan arrivals
dir.create(OUTPUT_DIR, recursive = TRUE, showWarnings = FALSE)
# ---- HELPERS ----------------------------------------------------------------
completed_years <- function(birth, ref) {
by <- as.integer(format(birth, "%Y"))
bm <- as.integer(format(birth, "%m"))
bd <- as.integer(format(birth, "%d"))
ry <- as.integer(format(ref,   "%Y"))
rm <- as.integer(format(ref,   "%m"))
rd <- as.integer(format(ref,   "%d"))
a <- ry - by
a - as.integer((rm < bm) | (rm == bm & rd < bd))
}
fmt_m <- function(k) sprintf("%.1fm", k / 1000)
stop_if <- function(cond, msg) if (isTRUE(cond)) stop(msg, call. = FALSE)
banner <- function(txt) {
cat("\n", strrep("=", 78), "\n", txt, "\n", strrep("=", 78), "\n", sep = "")
}
# Find the first candidate directory containing every required file.
resolve_data_dir <- function(files, override = NULL, candidates = c(".")) {
if (!is.null(override)) {
missing <- files[!file.exists(file.path(override, files))]
stop_if(length(missing) > 0,
paste0("FATAL: DATA_DIR set to '", override,
"' but these files are absent: ",
paste(missing, collapse = ", ")))
return(override)
}
for (d in candidates) {
if (all(file.exists(file.path(d, files)))) return(d)
}
# Nothing matched - report per-directory detail rather than a bare failure
cat("\nSearched for:", paste(files, collapse = ", "), "\n")
for (d in candidates) {
present <- files[file.exists(file.path(d, files))]
cat("  ", normalizePath(d, mustWork = FALSE), " -> ",
if (length(present) == 0) "none found"
else paste0(length(present), " of ", length(files), ": ",
paste(present, collapse = ", ")), "\n", sep = "")
}
cat("\nWorking directory:", getwd(), "\n")
stop("FATAL: could not locate all required CSV files. ",
"Set DATA_DIR explicitly at the top of this script.", call. = FALSE)
}
# ---- LOAD -------------------------------------------------------------------
banner("LOADING DATA")
REQUIRED_FILES <- c("player_club.csv", "players.csv", "teams.csv")
data_dir <- resolve_data_dir(REQUIRED_FILES,
override   = DATA_DIR,
candidates = DATA_DIR_TRY)
