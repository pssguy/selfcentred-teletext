# Load required libraries
library(data.table)
library(dplyr)
library(lubridate)
# Function to read CSV and convert to data.table
read_csv_dt <- function(filename) {
data <- read.csv(paste0("data/", filename, ".csv"), stringsAsFactors = FALSE)
return(as.data.table(data))
}
# Function to safely check if column exists
check_column <- function(data, col_name) {
if (col_name %in% names(data)) {
return(data[[col_name]])
} else {
cat("Warning: Column", col_name, "not found. Available columns:", paste(names(data), collapse = ", "), "\n")
return(NA)
}
}
# Function to safely convert dates
safe_date_convert <- function(date_col) {
if (is.character(date_col)) {
# Try multiple date formats
result <- tryCatch({
as.Date(date_col)
}, error = function(e) {
tryCatch({
as.Date(date_col, format = "%m/%d/%Y")
}, error = function(e2) {
tryCatch({
as.Date(date_col, format = "%Y-%m-%d")
}, error = function(e3) {
cat("Warning: Could not convert dates. Using NA.\n")
as.Date(rep(NA, length(date_col)))
})
})
})
return(result)
} else if (is.numeric(date_col)) {
# Assuming Excel serial date
return(as.Date(date_col, origin = "1899-12-30"))
} else {
return(as.Date(date_col))
}
}
