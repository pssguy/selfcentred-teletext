# Python code to generate the word list
python_code <- "
import nltk
from nltk.corpus import words
nltk.download('words')
word_list = words.words()
five_letter_words = sorted(set(word.upper() for word in word_list if len(word) == 5 and word.isalpha()))
with open('five_letter_words.txt', 'w') as f:
for word in five_letter_words:
f.write(word + '\\n')
print(f'The file \'five_letter_words.txt\' has been created with {len(five_letter_words)} words.')
"
# Execute the Python code using reticulate
py_run_string(python_code)
